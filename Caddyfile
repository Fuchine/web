# Reverse proxy + automatic TLS for the self-host deploy. Caddy terminates HTTPS
# (Let's Encrypt when SITE_ADDRESS is a real domain; a local CA for `localhost`)
# and sets X-Forwarded-* so Auth.js `trustHost` sees the correct external host.
# The `web` service publishes no host port — Caddy is the only way in.
#
# Set SITE_ADDRESS in .env:
#   - production: SITE_ADDRESS=fuchine.example.com   (auto HTTPS)
#   - local test: SITE_ADDRESS=localhost             (local CA) or :80 (no TLS)

#
# Caddy REPLACES any client-sent X-Forwarded-For with the real peer address (it
# only trusts XFF from `trusted_proxies`, none here), so the per-IP magic-link
# rate limit can't be spoofed. A different proxy in front must do the same.

{$SITE_ADDRESS:localhost} {
	# Cap every request body (B1). The largest legit body is an extension import
	# (a 3h video ≈ 3k caption lines ≈ 0.5 MB of JSON). Over the cap → 413.
	# Test: head -c 3000000 /dev/zero | curl -sk -o /dev/null -w '%{http_code}\n' \
	#         -X POST -H 'Content-Type: application/json' --data-binary @- \
	#         https://$SITE_ADDRESS/api/import          # expect 413
	#
	# One exception (T3.4): the admin dictionary upload (a Yomitan .zip) may be
	# up to 100 MB. The app rejects non-admins before reading the body and caps
	# it again at DICT_MAX_UNCOMPRESSED_MB. Exact path + POST only; everything
	# else keeps the 2 MB cap.
	@dictUpload {
		method POST
		path /api/admin/dictionaries
	}
	@notDictUpload not {
		method POST
		path /api/admin/dictionaries
	}
	request_body @dictUpload {
		max_size 100MB
	}
	request_body @notDictUpload {
		max_size 2MB
	}
	encode gzip
	reverse_proxy web:3000
}
