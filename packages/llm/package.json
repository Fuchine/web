{
  "name": "@fuchine/llm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:explain": "node --experimental-transform-types --no-warnings --import ./scripts/ts-register.mjs eval/explain.ts",
    "prompt:lock": "node --experimental-transform-types --no-warnings --import ./scripts/ts-register.mjs scripts/prompt-lock.ts"
  },
  "dependencies": {
    "@fuchine/db": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
