{
  "name": "fuchine-importer",
  "private": true,
  "version": "0.2.0",
  "description": "Fuchine Importer browser extension: send a video's Japanese captions to your Fuchine instance.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
