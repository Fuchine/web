# Copy to .env and fill in. Never commit real secrets.

# --- Database (Postgres) ---
DATABASE_URL=postgres://fuchine:fuchine@localhost:5432/fuchine

# --- Queue / cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- BYOK key encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
FUCHINE_ENCRYPTION_KEY=

# --- Deployment mode: "self-host" (default) or "cloud" ---
DEPLOYMENT_MODE=self-host

# --- Default LLM provider for self-host (anthropic | openai | gemini | ollama) ---
# The user's own key is read from user_settings (BYOK); this only picks the adapter.
LLM_PROVIDER=
