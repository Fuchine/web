# Copy to .env and fill in. Never commit real secrets.

# --- Database (Postgres) ---
DATABASE_URL=postgres://fuchine:fuchine@localhost:5432/fuchine
# Max pool connections per process (default 10). Budget web + worker + any
# backfill/seed script under Postgres' max_connections (default 100).
# DB_POOL_MAX=10

# Postgres password used by docker compose (set at first run). DATABASE_URL
# above is for local dev (host port); the compose services use this env in
# the connection string they construct. Changing it on an existing volume
# requires a manual ALTER USER — see docs/DEPLOY_CHECKLIST.md.
POSTGRES_PASSWORD=change-me

# --- Queue / cache (Redis) ---
REDIS_URL=redis://localhost:6379
# Redis password used by docker compose (requirepass). REDIS_URL above is
# for local dev (host port); the compose services use this env in the
# connection string they construct.
REDIS_PASSWORD=change-me

# --- Auth.js ---
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic-link provider (SMTP). Leave EMAIL_SERVER empty in local dev to get
# a console magic-link (printed to the `next dev` terminal, no SMTP needed).
# For real delivery, set them, e.g.:
#   EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
#   EMAIL_FROM="Fuchine <login@example.com>"
EMAIL_SERVER=
EMAIL_FROM=

# --- Registration control (who can create an account) ---
# open    = anyone with a Google account (or any e-mail, with SMTP) can sign up
# invite  = existing users + the allowlists below + e-mails with an active invite
# closed  = existing users + the allowlists below only
# Unset   = open in development, INVITE in production (never open by omission).
# Every new user can spend the house LLM key, so don't run a public instance open.
# Invites: pnpm --filter @fuchine/worker invite add friend@example.com [--days 14]
#   (compose: docker compose run --rm worker pnpm --filter @fuchine/worker invite add <email>)
# REGISTRATION=invite
# Comma-separated. Applies in every mode — put your own address here so the
# first account needs no invite. Domains match exactly (example.com, not sub.example.com);
# with Google, only verified e-mails match a domain or an invite.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=

# --- BYOK key encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# PERMANENT: back this up alongside the database. Losing it makes every saved
# BYOK key undecryptable (users must re-enter theirs). To rotate it, set the old
# value as OLD_ENCRYPTION_KEY and run: pnpm --filter @fuchine/worker rotate:key
FUCHINE_ENCRYPTION_KEY=

# --- Deployment mode: "self-host" (default) or "cloud" ---
DEPLOYMENT_MODE=self-host

# --- Timezone ---
# Defines "today" for streaks, daily goals, and the heatmap. Set it to your
# local zone — otherwise a UTC container flips the day mid-evening and studying
# at night can break the streak. Applies instance-wide (single-user / self-host).
TZ=America/Sao_Paulo

# --- Layer-1 import translation (worker house key, self-host) ---
# Provider for batch translation at import time. "echo" (default) needs no key
# and leaves lines JP-only. For real translation use an OpenAI-compatible
# backend, e.g. MiniMax:
#   LLM_PROVIDER=minimax
#   LLM_API_KEY=<your MiniMax token>
# Optional overrides (sensible defaults per provider):
#   LLM_BASE_URL=https://api.minimax.io/v1
#   LLM_MODEL=minimax-m3
# Or DeepL (translation-only; base URL is auto-detected from the key, a ":fx"
# suffix = Free plan). DeepL cannot do layer-2 explanations:
#   LLM_PROVIDER=deepl
#   LLM_API_KEY=<your DeepL auth key>
# Per-user layer-2 explanations use the user's own BYOK key from Settings
# (LLM provider only — DeepL is not an explanation provider).
LLM_PROVIDER=echo

# Cap the eager per-import layer-2 pre-warm to the first N lines (default 150).
# The rest is generated on demand by the player's prefetch as the viewer
# reaches it. Raise it to warm the whole video eagerly (higher cost per import).
# PREWARM_MAX_LINES=150
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- House-key spend ceiling (T2.4) ---
# Daily ceiling on tokens (input + output) spent with the house LLM key, across
# web and worker, per local day (TZ above). At the ceiling, new explanations
# for users without their own key, chunk translation misses and the explain
# pre-warm pause until midnight; cached content and BYOK keep working.
# Unset = no ceiling (production warns). Check today's spend with:
#   pnpm --filter @fuchine/worker usage
# HOUSE_DAILY_TOKEN_BUDGET=2000000
# false = users without a BYOK key can't generate new explanations on the
# house key (cached ones still serve). Translation and pre-warm unaffected.
# HOUSE_EXPLAIN_FALLBACK=true

# --- Layer-1 MT provider (optional; DeepL recommended) ---
# Fast machine-translation backend for the lazy chunk translation, with
# automatic fallback to LLM_PROVIDER when it rate-limits or fails. A ":fx"
# key suffix = DeepL Free (host auto-detected). Unset = use LLM_PROVIDER.
#   MT_PROVIDER=deepl
#   MT_API_KEY=<your DeepL auth key>
MT_PROVIDER=
MT_API_KEY=
MT_BASE_URL=

# --- Published images (docker-compose.release.yml) ---
# Only read when running the GHCR images instead of building from source:
#   docker compose -f docker-compose.yml -f docker-compose.release.yml up -d
# (or set COMPOSE_FILE=docker-compose.yml:docker-compose.release.yml here).
# latest | v0.1.0 | 0.1 — pin a release for predictable upgrades. For an
# immutable pin set FUCHINE_WEB_IMAGE / FUCHINE_WORKER_IMAGE to
# ghcr.io/fuchine/fuchine-{web,worker}:v0.1.0@sha256:<digest>.
# FUCHINE_VERSION=latest
