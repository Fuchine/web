{
  "name": "@fuchine/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:explain": "tsx src/scripts/backfill-explain.ts",
    "backfill:level": "tsx src/scripts/backfill-level.ts",
    "backfill:daily-stats": "tsx src/scripts/backfill-daily-stats.ts",
    "backfill:word-counts": "tsx src/scripts/backfill-word-counts.ts",
    "rotate:key": "tsx src/scripts/rotate-encryption-key.ts",
    "invite": "tsx src/scripts/invite.ts",
    "usage": "tsx src/scripts/usage.ts",
    "refresh:metadata": "tsx src/scripts/refresh-metadata.ts",
    "dict:import": "tsx src/scripts/dict.ts import",
    "dict:list": "tsx src/scripts/dict.ts list",
    "dict:remove": "tsx src/scripts/dict.ts remove"
  },
  "dependencies": {
    "@fuchine/db": "workspace:*",
    "@fuchine/jobs": "workspace:*",
    "@fuchine/llm": "workspace:*",
    "@fuchine/nlp": "workspace:*",
    "bullmq": "^6.5.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^4.1.12"
  }
}
